# ============================================================
# StellarKraal — Environment Variables
# ============================================================
# Copy this file to .env and fill in values for local dev:
#   cp .env.example .env
#
# Variables marked [Required] must be set before the service
# will start. Variables marked [Optional] have safe defaults.
#
# Variables marked [GitHub Secret: NAME] must also be stored
# as GitHub Actions repository secrets (Settings → Secrets
# and variables → Actions) so CI/CD workflows can inject them.
# Never commit real secrets to version control.
# ============================================================


# ------------------------------------------------------------
# SHARED — used by both frontend and backend
# ------------------------------------------------------------

# Stellar network to connect to.
# Format : "testnet" | "mainnet"
# Required. [GitHub Secret: NEXT_PUBLIC_NETWORK]
NEXT_PUBLIC_NETWORK=testnet

# Soroban JSON-RPC endpoint for the chosen network.
# Format : HTTPS URL
# Required. [GitHub Secret: RPC_URL]
RPC_URL=https://soroban-testnet.stellar.org

# Deployed Soroban contract address (C... or G... format).
# Obtain this after running `stellar contract deploy`.
# Format : 56-character Stellar contract/account ID
# Required. [GitHub Secret: CONTRACT_ID]
CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM


# ------------------------------------------------------------
# FRONTEND — Next.js (NEXT_PUBLIC_* vars are bundled at build)
# ------------------------------------------------------------

# Base URL of the backend API, used by the Next.js frontend.
# Must be reachable from the browser in production.
# Format : HTTP(S) URL, no trailing slash
# Required. [GitHub Secret: NEXT_PUBLIC_API_URL]
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public Soroban RPC URL exposed to browser-side SDK calls.
# Usually the same value as RPC_URL.
# Format : HTTPS URL
# Required. [GitHub Secret: NEXT_PUBLIC_RPC_URL]
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org


# ------------------------------------------------------------
# BACKEND — Node.js / Express API
# ------------------------------------------------------------

# TCP port the Express server listens on.
# Format : integer 1–65535
# Optional. Default: 3001
PORT=3001

# Node.js runtime environment. Controls logging verbosity,
# error detail, and certain security defaults.
# Format : "development" | "production" | "test"
# Optional. Default: development
NODE_ENV=development

# Allowed CORS origin for the backend. In production, set to the exact
# deployed frontend URL. Comma-separate multiple origins.
# Format : HTTP(S) URL, no trailing slash  (wildcard "*" blocked in production)
# Optional. [GitHub Secret: FRONTEND_URL]
FRONTEND_URL=http://localhost:3000

# Comma-separated list of additional allowed CORS origins beyond FRONTEND_URL.
# Wildcard "*" is rejected in production.
# Format : comma-separated HTTP(S) URLs
# Optional.
# ALLOWED_ORIGINS=http://localhost:3000,https://app.stellarkraal.example.com

# Secret used to sign and verify JWT access tokens. Minimum 32 characters.
# Generate: openssl rand -hex 32
# Required in production. [GitHub Secret: JWT_SECRET]
JWT_SECRET=change-me-to-a-strong-jwt-secret-minimum-32-chars!!

# JWT access token time-to-live in milliseconds.
# Optional. Default: 900000 (15 minutes)
ACCESS_TTL_MS=900000

# JWT refresh token time-to-live in milliseconds.
# Optional. Default: 604800000 (7 days)
REFRESH_TTL_MS=604800000

# HMAC-SHA256 secret for verifying incoming webhook payloads. Min 16 chars.
# Generate: openssl rand -hex 32
# Optional (signature verification skipped when unset). [GitHub Secret: WEBHOOK_SECRET]
# WEBHOOK_SECRET=

# Bearer token protecting the /api/admin/* endpoints. Min 8 characters.
# Generate: openssl rand -hex 16
# Optional (admin routes return 403 when unset). [GitHub Secret: ADMIN_API_KEY]
# ADMIN_API_KEY=

# Origination fee charged on each new loan, in basis points (50 = 0.5%).
# Contract enforces a hard max of 500 bps. Optional. Default: 50
ORIG_FEE_BPS=50

# Health factor warning threshold (×10_000). Fires a warning alert when HF
# drops below this value. Optional. Default: 13000 (1.3)
HEALTH_FACTOR_WARN=13000

# Health factor critical threshold (×10_000). Fires a critical alert and
# triggers liquidation eligibility. Optional. Default: 10000 (1.0)
HEALTH_FACTOR_CRIT=10000

# --- Rate Limiting (requests per minute per IP) ---

# Global rate limit applied to every route. Optional. Default: 60
RATE_LIMIT_GLOBAL=60

# Rate limit for /auth/* routes (brute-force protection). Optional. Default: 10
RATE_LIMIT_AUTH=10

# Rate limit for read-only GET routes. Optional. Default: 100
RATE_LIMIT_READ=100

# Rate limit for state-changing POST/PUT/DELETE routes. Optional. Default: 10
RATE_LIMIT_WRITE=10

# --- Request Timeouts (milliseconds) ---

# Maximum time for any request before a 408 is returned. Optional. Default: 30000
TIMEOUT_GLOBAL_MS=30000

# Maximum time for write operations (loan origination, collateral updates). Optional. Default: 15000
TIMEOUT_WRITE_MS=15000

# Maximum time for Soroban contract submission routes. Optional. Default: 30000
TIMEOUT_CONTRACT_MS=30000

# Graceful shutdown drain timeout in ms (min 1000). On SIGTERM/SIGINT the
# server stops accepting new connections and waits up to this duration before
# forcing exit. Optional. Default: 10000
SHUTDOWN_TIMEOUT_MS=10000

# --- RPC Connection Pool ---

# Minimum persistent RPC connections. Optional. Default: 2
POOL_MIN=2

# Maximum concurrent RPC connections. Optional. Default: 10
POOL_MAX=10

# How long collateral appraisal results are cached before a fresh RPC call.
# In milliseconds. Optional. Default: 300000 (5 minutes)
APPRAISAL_CACHE_TTL_MS=300000

# --- Logging ---

# Log level: debug, info, warn, error. Optional. Default: info
LOG_LEVEL=info

# Max size per log file before rotation (e.g., 10m, 100m). Optional. Default: 10m
LOG_MAX_SIZE=10m

# Number of rotated log files to retain. Optional. Default: 7
LOG_MAX_FILES=7

# Directory path where structured audit logs are written.
# If unset, audit logging is disabled.
# Format : absolute or relative filesystem path
# Optional.
# AUDIT_LOG_DIR=/var/log/stellarkraal/audit

# Bearer token protecting the Prometheus /metrics endpoint.
# When unset, /metrics is unauthenticated (local dev only).
# Generate: openssl rand -hex 32
# Optional (production: recommended). [GitHub Secret: METRICS_TOKEN]
# METRICS_TOKEN=

# --- Database ---

# PostgreSQL connection URL. Omit for SQLite (local development).
# Required in production (staging/prod use PostgreSQL).
# Format : postgresql://user:password@host:5432/dbname
# Optional (falls back to SQLite when unset). [GitHub Secret: DATABASE_URL]
# DATABASE_URL=postgresql://user:password@localhost:5432/stellarkraal


# ------------------------------------------------------------
# ALERTING — Slack & PagerDuty (backend alert dispatcher)
# ------------------------------------------------------------

# Slack incoming webhook URL for deployment and alert messages.
# Create one at https://api.slack.com/messaging/webhooks
# Format : https://hooks.slack.com/services/T.../B.../...
# Optional (Slack alerts disabled if unset). [GitHub Secret: SLACK_WEBHOOK_URL]
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# PagerDuty Events API v2 routing key for critical-severity alerts.
# Find this in PagerDuty under Services → Integrations.
# Format : 32-character alphanumeric string
# Optional (PagerDuty alerts disabled if unset). [GitHub Secret: PAGERDUTY_ROUTING_KEY]
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Stellar Horizon API URL (used as fallback for account balance reads when Soroban RPC is unavailable)
# HORIZON_URL=https://horizon-testnet.stellar.org


# ------------------------------------------------------------
# DOCKER — Grafana observability service
# (docker-compose.prod.yml passes the .env file to Grafana)
# ------------------------------------------------------------

# Grafana admin username. Used to log in to the Grafana UI at /login.
# Format : non-empty string
# Optional. Default: admin
# [GitHub Secret: GF_SECURITY_ADMIN_USER]
GF_SECURITY_ADMIN_USER=admin

# Grafana admin password. Change this before exposing Grafana publicly.
# Generate a strong value: openssl rand -hex 16
# Format : non-empty string, minimum 8 characters recommended
# Required in production. [GitHub Secret: GF_SECURITY_ADMIN_PASSWORD]
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password

# Allow unauthenticated read-only access to Grafana dashboards.
# Set to "false" in production to require login.
# Format : "true" | "false"
# Optional. Default: true (dev/local), false (production)
GF_AUTH_ANONYMOUS_ENABLED=true

# Role assigned to anonymous users when GF_AUTH_ANONYMOUS_ENABLED=true.
# Format : "Viewer" | "Editor" | "Admin"
# Optional. Default: Viewer
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer


# ------------------------------------------------------------
# DOCKER — Prometheus metrics endpoint protection
# ------------------------------------------------------------

# Bearer token required to access the /metrics endpoint on the backend.
# When unset, /metrics is unauthenticated (acceptable for local dev only).
# Generate a strong value: openssl rand -hex 32
# Format : arbitrary string
# Optional (production: recommended). [GitHub Secret: METRICS_TOKEN]
# METRICS_TOKEN=


# ------------------------------------------------------------
# STAGING — docker-compose.staging.yml overrides
# These are consumed when running:
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d
# Store as GitHub Actions environment secrets under the "staging" environment.
# ------------------------------------------------------------

# Soroban testnet RPC endpoint for the staging deployment.
# Format : HTTPS URL
# Required for staging. [GitHub Secret: STAGING_RPC_URL]
STAGING_RPC_URL=https://soroban-testnet.stellar.org

# Soroban contract address for the staging deployment.
# Obtain after running `stellar contract deploy` against testnet.
# Format : 56-character Stellar contract/account ID
# Required for staging. [GitHub Secret: STAGING_CONTRACT_ID]
STAGING_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Public base URL of the staging backend API (used by the staging frontend).
# Format : HTTPS URL, no trailing slash
# Required for staging. [GitHub Secret: STAGING_API_URL]
STAGING_API_URL=https://api-staging.stellarkraal.example.com

# Staging frontend URL (used for CORS on the staging backend).
# Format : HTTPS URL, no trailing slash
# Required for staging. [GitHub Secret: STAGING_FRONTEND_URL]
STAGING_FRONTEND_URL=https://staging.stellarkraal.example.com
